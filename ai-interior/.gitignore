# API 키 — 절대 커밋하지 말 것
.env

# 파이썬
__pycache__/
*.pyc

# 재생성 가능한 산출물 (python pipeline/segment.py 로 몇 초면 다시 만든다)
samples/items_cutout/

# macOS
.DS_Store
samples/rooms_depth/
